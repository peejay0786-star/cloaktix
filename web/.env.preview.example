VITE_EGG40_RELAY_URL=https://cloaktix-door-relay.peejay0786.workers.dev
# Earlier rate-v3 contract (Test v3 event), still read by the app
VITE_RATE_V3_CONTRACT=b92733389b1955c913dec004df708a12697df4a962ffab5dbde1e88f574ab04e
