{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%paused_.0", "type": "Scalar<BLS12-381>" },
    { "name": "%newIssuer.1", "type": "Scalar<BLS12-381>" },
    { "name": "%newIssuer.2", "type": "Point<Jubjub>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_to_boolean", "val": "%paused_.0" },
    { "op": "constrain_to_boolean", "val": "%newIssuer.1" },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%sk.3", "guard": null },
    { "op": "constrain_bits", "val": "%sk.3", "bits": 8 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%sk.4", "guard": null },
    { "op": "constrain_bits", "val": "%sk.4", "bits": 248 },
    { "op": "persistent_hash", "output": "%bytes.5", "alignment": [{ "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%sk.3", "%sk.4"] },
    { "op": "bytes_into_natives", "outputs": ["%t.6", "%t.7"], "bytes": "%bytes.5" },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.8", "guard": null },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.9", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x04"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x20", "%t.8", "%t.9"] },
    { "op": "test_eq", "output": "%t.10", "a": "%t.7", "b": "%t.8" },
    { "op": "test_eq", "output": "%t.11", "a": "%t.6", "b": "%t.9" },
    { "op": "cond_select", "output": "%t.12", "bit": "%t.10", "a": "%t.11", "b": "0x00" },
    { "op": "assert", "cond": "%t.12" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x05"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "%paused_.0"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "encode", "outputs": ["%pt.13", "%pt.14"], "input": "%newIssuer.2" },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x0e"] },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0x11", "0x01", "0x02", "-0x02", "-0x02", "%pt.13", "%pt.14"] },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0x91"] }
  ]
}
