{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%paused_.0", "type": "Scalar<BLS12-381>" },
    { "name": "%newIssuer.1", "type": "Scalar<BLS12-381>" },
    { "name": "%newIssuer.2", "type": "Point<Jubjub>" },
    { "name": "%newRateSigner.3", "type": "Scalar<BLS12-381>" },
    { "name": "%newRateSigner.4", "type": "Point<Jubjub>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_to_boolean", "val": "%paused_.0" },
    { "op": "constrain_to_boolean", "val": "%newIssuer.1" },
    { "op": "constrain_to_boolean", "val": "%newRateSigner.3" },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%t.5", "guard": null },
    { "op": "constrain_bits", "val": "%t.5", "bits": 8 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%t.6", "guard": null },
    { "op": "constrain_bits", "val": "%t.6", "bits": 248 },
    { "op": "persistent_hash", "output": "%bytes.7", "alignment": [{ "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%t.5", "%t.6"] },
    { "op": "bytes_into_natives", "outputs": ["%t.8", "%t.9"], "bytes": "%bytes.7" },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.10", "guard": null },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.11", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x51", "0x01", "0x01", "0x00", "0x01", "0x01", "0x04"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x20", "%t.10", "%t.11"] },
    { "op": "test_eq", "output": "%t.12", "a": "%t.9", "b": "%t.10" },
    { "op": "test_eq", "output": "%t.13", "a": "%t.8", "b": "%t.11" },
    { "op": "cond_select", "output": "%t.14", "bit": "%t.12", "a": "%t.13", "b": "0x00" },
    { "op": "assert", "cond": "%t.14" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x70", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x03"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "%paused_.0"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0xa1"] },
    { "op": "encode", "outputs": ["%pt.15", "%pt.16"], "input": "%newIssuer.2" },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0x70", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x0c"] },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0x11", "0x01", "0x02", "-0x02", "-0x02", "%pt.15", "%pt.16"] },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0x91"] },
    { "op": "impact", "guard": "%newIssuer.1", "inputs": ["0xa1"] },
    { "op": "encode", "outputs": ["%pt.17", "%pt.18"], "input": "%newRateSigner.4" },
    { "op": "impact", "guard": "%newRateSigner.3", "inputs": ["0x70", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "%newRateSigner.3", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "%newRateSigner.3", "inputs": ["0x11", "0x01", "0x02", "-0x02", "-0x02", "%pt.17", "%pt.18"] },
    { "op": "impact", "guard": "%newRateSigner.3", "inputs": ["0x91"] },
    { "op": "impact", "guard": "%newRateSigner.3", "inputs": ["0xa1"] }
  ]
}
